# 电商混合智能中台 —— 环境变量配置示例
# 复制为 .env 或直接 export

# LLM 切换（核心）
# mock  = 确定性测试替身（测试/离线，默认）
# ollama = 对接本机 Ollama（本地免费，推荐演示用）
# openai = 对接 OpenAI 兼容 API（Qwen/DashScope 等）
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:0.5b
# Ollama 服务地址（本机默认，指向远程虚拟机 Ollama 时改这里）
LLM_BASE_URL=http://127.0.0.1:11434

# 若 LLM_PROVIDER=openai 需要：
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# A2A 外部委派
A2A_TIMEOUT_SECONDS=5.0
A2A_IDEMPOTENCY_ENABLED=1

# 服务
HOST=0.0.0.0
PORT=8000
